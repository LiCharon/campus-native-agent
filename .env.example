# 复制为 .env 后填写真实值；.env 已被 gitignore，不入库。

# DeepSeek（OpenAI 兼容，见 docs/TECH_DECISIONS.md §2）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Langfuse（开发期 Cloud 免费额度，见 docs/TECH_DECISIONS.md §5）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# MySQL 8（M3 起本地 MySQL80 服务；pymysql 驱动需 >=1.1 支持 caching_sha2_password）
DATABASE_URL=mysql+pymysql://root:密码@127.0.0.1:3306/campus_desk?charset=utf8mb4

# 超时升级扫描（M5：scheduler/escalation.py；P1 超 4h / P2 超 48h 升级一次，PENDING_VERIFY 挂起 72h 自动关闭）
ESCALATION_P1_HOURS=4
ESCALATION_P2_HOURS=48
AUTO_CLOSE_HOURS=72
SCAN_INTERVAL_SECONDS=60

# 登录鉴权（M6：JWT HS256，dev 默认值 >=32 字节；生产必须改）
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_EXPIRE_MINUTES=1440

# 业务参数配置（M6 可配化；缺省走 config/business_rules.json，一般无需改）
# BUSINESS_CONFIG_PATH=config/business_rules.json
