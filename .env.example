# 复制为 .env 后填写真实值；.env 已被 gitignore，不入库。

# DeepSeek（OpenAI 兼容，见 docs/TECH_DECISIONS.md §2）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

# Langfuse（开发期 Cloud 免费额度，见 docs/TECH_DECISIONS.md §5）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# MySQL 8（业务数据源；pymysql 驱动需 >=1.1 支持 caching_sha2_password）
DATABASE_URL=mysql+pymysql://root:密码@127.0.0.1:3306/campus_desk?charset=utf8mb4

# Qdrant 向量库（M10；留空=不启用，检索走 MySQL 稠密向量兜底）。容器: http://localhost:6333
# 本地磁盘模式（无需起服务）填目录路径，如 C:/campusdesk_qdrant_data
QDRANT_URL=

# 本地嵌入模型目录（M10；可选但离线/内网必需，否则检索层降级到纯关键词）
# 主源 HuggingFace 在本机网络不可达，需手动下载后指本地目录：
#   BGE_LOCAL_PATH   = GCS 拉取的 fast-bge-small-zh-v1.5 解压目录（稠密 512 维）
#   BM25_LOCAL_PATH  = HF 拉取的 Qdrant/bm25 解压快照目录（稀疏腿；须配合 embeddings.py 的 jieba 分词注入）
# 留空 = 直连 HuggingFace 下载（需联网）。
BGE_LOCAL_PATH=
BM25_LOCAL_PATH=

# M13 成本报表单价（元 / 百万 token）：脚本 scripts/cost_report.py 按此派生费用，
# llm_usage 表只存 token 不存钱——改价后重跑报表即按新价，历史记录不重算。
# 默认按 DeepSeek 公开价（输入 2 / 输出 8），换模型或调价时改这里。
DEEPSEEK_INPUT_PRICE=2.0
DEEPSEEK_OUTPUT_PRICE=8.0

# 登录鉴权（JWT HS256）
# ⚠️ 部署前必须换成随机长串（≥32 字符）：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 沿用下面的默认值，服务会拒绝启动；与默认串相似（改大小写/加缀/截短）或长度不足同样拒绝
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_EXPIRE_MINUTES=1440
# 逃生阀：置 1 时允许沿用上面的默认密钥（仅本地开发；对"自己设的短密钥"无效）
ALLOW_INSECURE_DEV=0
