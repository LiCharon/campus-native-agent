# Python 自动产物（运行时自动生成，可随时重建）
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
*.egg-info/

# 密钥（CLAUDE.md §4 规定密钥不入库）
.env

# 本地品牌覆盖（含 ZJUT 等本地化配置，不进公开 repo；通用默认值在源码 brand.js 中回退）
.env.local
.env.*.local


# 本地 SQLite 数据库（checkpointer 会话库 / 临时验证库）
*.db

# 规划文档（docs/ 独立本地私有仓库管理，不公开，见 docs/.git）
docs/

# 工具/个人产物
.qoderwork/
.workbuddy/
.claude/

# SQLite WAL/SHM 附属文件（checkpointer 运行期生成）
*.db-shm
*.db-wal
docker-compose.override.yml

# 本地真实信息注入数据（T9：不进公开 repo，scripts/seed_zjut_local.py 读取）
config/zjut_local_data.json
# M11 采集产物（build_zjut_entries.py 输出，同源本地数据不进公开 repo）
config/zjut_m11_data.json

# M11 采集原始文档（Tier 1 公开源下载产物，不进公开 repo）
data/zjut_raw/
